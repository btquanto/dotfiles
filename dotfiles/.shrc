#!/bin/sh

export TERM=xterm-256color
export AR_DIR=~/.archive
export MANPAGER="vim -c '%s/_\|.\|\[[0-9]*m//e' -c 'set nonumber buftype=nofile filetype=man' -c 'goto' -"
export EDITOR=vim
export VISUAL=vim
export PAGER=less

alias vi=vim
alias view=vim
alias ls='ls -AFh --color=auto'
alias grep='grep --binary-files=without-match --color'
alias locate='locate --basename --existing'
alias screen="screen -DR"
alias cd="my_cd"

export PATH="$PATH:/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin:$HOME/bin:$HOME/.local/bin:$HOME/.local/sbin"

_LOCAL_CONFIG="$HOME/.local/shrc.sh";
test -f "$_LOCAL_CONFIG" && . "$_LOCAL_CONFIG" || touch "$_LOCAL_CONFIG";
